---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props as Props;

---

<footer class:list={["px-4 text-center", compact ? "py-8 sm:py-10" : "py-12 sm:py-16"]}>
  <p class="text-xs leading-relaxed text-his-text-secondary">
    Cover art Jessica Han
    <span aria-hidden="true"> · </span>
    Music <a href="https://twitter.com/kenwheeler" class="underline underline-offset-2 hover:text-his-green transition-colors">Ken Wheeler</a>
    <span aria-hidden="true"> · </span>
    <a href="https://github.com/sponsors/hzoo" class="underline underline-offset-2 hover:text-his-green transition-colors">Sponsor</a>
  </p>
</footer>
