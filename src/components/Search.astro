---
// Search with Spotlight-style modal (input inside modal)
interface Props {
  variant?: "full" | "compact" | "sidebar";
}

const { variant = "full" } = Astro.props;
---

<!-- Sidebar trigger button -->
<button class:list={["search-trigger", variant !== "full" && `search-trigger-${variant}`]} id="search-trigger" type="button" aria-label="Search transcripts" data-dev={import.meta.env.DEV ? "true" : undefined}>
  <svg class="search-trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.35-4.35"/>
  </svg>
  <span class="search-trigger-text">Search</span>
  <kbd class="search-trigger-kbd">/</kbd>
</button>

<script src="../scripts/search-entry.ts"></script>


<style>
  /* Sidebar trigger button - matches hamburger height */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.625rem;
    background: var(--color-his-hover);
    border: 1px solid var(--color-his-hr);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .search-trigger:hover {
    background: var(--color-his-active);
    border-color: var(--color-his-text-tertiary);
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--color-his-green);
    outline-offset: 2px;
  }

  .search-trigger.search-trigger-sidebar {
    width: auto;
    min-height: 40px;
    padding-inline: 0.625rem;
    background: transparent;
    border-color: transparent;
  }

  .search-trigger-sidebar:hover {
    background: var(--color-his-hover);
    border-color: transparent;
  }

  .search-trigger-sidebar .search-trigger-text {
    flex: none;
  }

  .search-trigger-sidebar .search-trigger-kbd {
    display: none;
  }

  .search-trigger.search-trigger-compact {
    width: 40px;
    height: 40px;
    padding: 0;
    justify-content: center;
    flex: none;
  }

  .search-trigger-compact .search-trigger-icon {
    width: 1rem;
    height: 1rem;
  }

  .search-trigger-compact .search-trigger-text,
  .search-trigger-compact .search-trigger-kbd {
    display: none;
  }

  .search-trigger-icon {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-his-text-secondary);
    flex-shrink: 0;
  }

  .search-trigger-text {
    flex: 1;
    text-align: left;
    font-size: 0.8125rem;
    color: var(--color-his-text-secondary);
  }

  .search-trigger-kbd {
    font-size: 0.625rem;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    background: var(--color-his-bg);
    color: var(--color-his-text-tertiary);
    font-family: ui-monospace, monospace;
    border: 1px solid var(--color-his-hr);
  }
</style>
