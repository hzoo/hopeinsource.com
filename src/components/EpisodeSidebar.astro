---
import { formatEpisodeDate } from "@/lib/dates";
import { getEpisodeData } from "@/lib/episodes";
import Search from "./Search.astro";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const { archiveGroups } = await getEpisodeData();
---

<!-- Mobile backdrop -->
<div
  id="sidebar-backdrop"
  class="lg:hidden fixed inset-0 bg-black/50 z-[45] opacity-0 invisible transition-opacity duration-300"
></div>

<!-- Sidebar -->
<aside
  id="episode-sidebar"
  aria-label="Episode browser"
  class="fixed left-0 top-0 h-full w-[280px] sm:w-80 max-w-[calc(100vw-3rem)] bg-his-bg border-r border-his-hr z-50
         transform -translate-x-full lg:translate-x-0 transition-transform duration-300
         flex flex-col"
>
  <!-- Sidebar header with search, home, and mobile close -->
  <div class="px-3 py-3 flex-shrink-0 flex items-center gap-2">
    <div class="flex-1 min-w-0">
      <Search />
    </div>
    <a
      href="/"
      class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg text-his-text-secondary no-underline transition-colors hover:bg-his-hover hover:text-his-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60"
      aria-label="All episodes"
      title="All episodes"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
    </a>
    <button
      id="sidebar-close"
      class="lg:hidden w-10 h-10 flex items-center justify-center rounded-lg hover:bg-his-hover text-his-text-tertiary transition-colors"
      aria-label="Close sidebar"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Scrollable content (hidden scrollbar) -->
  <div class="overflow-y-auto flex-1 p-3 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
    <!-- Episodes list -->
    {archiveGroups.map((group) => (
      <section class="mb-6">
        {group.id !== "0" && (
          <h3 class="mb-3 px-3 text-xs font-semibold uppercase tracking-[0.14em] text-his-green">{group.label}</h3>
        )}
        <div class="space-y-0.5">
          {group.episodes.map((episode) => {
            const isActive = episode.slug === currentSlug;
            return (
              <a
                href={`/${episode.slug}`}
                class:list={[
                  "episode-link group relative block rounded-lg px-3 py-2.5 transition-[color,background-color,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60",
                  isActive
                    ? "bg-his-green/12 ring-1 ring-his-green/25"
                    : "hover:bg-his-hover/60"
                ]}
                aria-current={isActive ? "page" : undefined}
                title={formatEpisodeDate(episode.data.date)}
              >
                <div class="flex items-start gap-2.5">
                  <span class:list={[
                    "flex-shrink-0 pt-0.5 font-mono text-xs tabular-nums transition-colors",
                    isActive ? "text-his-green" : "text-his-text-secondary"
                  ]}>
                    {episode.epNumber}
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-2">
                      <div class="flex items-center gap-1.5 flex-1 min-w-0">
                        <span class:list={[
                          "min-w-0 flex-1 text-sm font-normal leading-snug transition-colors",
                          isActive ? "font-semibold text-his-green" : "text-his-text"
                        ]}>
                          {episode.episodeTitle}
                        </span>
                      </div>
                      {(episode.data.sauntercast || episode.data.video?.url) && (
                        <div class="flex items-center gap-1 flex-shrink-0">
                          {episode.data.sauntercast && (
                            <span class:list={[
                              "inline-flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full border",
                              isActive
                                ? "border-his-green/40 bg-his-green/15 text-his-green"
                                : "border-his-hr bg-his-hover/60 text-his-text-secondary group-hover:border-his-green/30 group-hover:text-his-green"
                            ]} title="Sauntercast">
                              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M13.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7" />
                              </svg>
                              <span class="sr-only">Sauntercast</span>
                            </span>
                          )}
                          {episode.data.video?.url && (
                            <span class:list={[
                              "inline-flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full border",
                              isActive
                                ? "border-his-green/40 bg-his-green/15 text-his-green"
                                : "border-his-hr bg-his-hover/60 text-his-text-secondary group-hover:border-his-green/30 group-hover:text-his-green"
                            ]} title="Video episode">
                              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M8 5v14l11-7z" />
                              </svg>
                              <span class="sr-only">Video episode</span>
                            </span>
                          )}
                        </div>
                      )}
                    </div>
                    {episode.guestDisplays.length > 0 && (
                      <span class="mt-0.5 block text-[13px] leading-snug text-his-text-secondary transition-colors group-hover:text-his-text">
                        {episode.guestDisplays.map((g, i) => (
                            <>
                              {i > 0 && ", "}
                              {g.name}{g.count > 1 && <sup class="ml-0.5 text-[10px] font-medium text-his-green">×{g.count}</sup>}
                            </>
                          ))}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</aside>

<script src="../scripts/sidebar.ts"></script>
