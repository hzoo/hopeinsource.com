---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import Subscribe from "@/components/Subscribe.astro";

interface Props {
  page: "home" | "episodes";
  title?: string;
  description?: string;
}

const { page, title, description } = Astro.props;
const isHome = page === "home";
const slug = isHome ? "/" : "/episodes";
const coverSrcSet = [128, 472, 944].map((width) => `/artwork/his-${width}.webp ${width}w`).join(", ");
const smallCover = "/artwork/his-128.webp";
const coverClass = "brand-cover w-full max-w-[472px] h-auto aspect-square object-contain mb-4 sm:max-w-[90%]";
const emptyImage = "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
---

<Layout frontmatter={{ title, description }} slug={slug}>
  <div id="home-layout-root" class:list={["home-root", !isHome && "home-secondary"]}>
    <header id="home-brand">
      <div class="brand-inner">
        <div class="brand-content flex flex-col items-center text-center max-w-[472px] mx-auto">
          {isHome
            ? <h1 class="brand-title m-0">Hope in Source</h1>
            : <span class="brand-title m-0">Hope in Source</span>}
          <picture class="contents">
            <source media={isHome ? "(min-width: 960px)" : "(min-width: 1200px)"} type="image/webp" srcset={coverSrcSet} sizes="352px" />
            <img
              src={isHome ? smallCover : emptyImage}
              alt="Hope in Source Cover Art"
              width="472"
              height="472"
              class={coverClass}
              loading={isHome ? "eager" : "lazy"}
              fetchpriority={isHome ? "high" : undefined}
              decoding="async"
            />
          </picture>
          <div class="brand-taglines text-center space-y-1">
            <p class="m-0 text-lg font-medium tracking-wide">
              off-the-cuff conversations between friends
            </p>
            <p class="m-0 text-[0.85rem] text-his-text-secondary italic">
              finding the sacred in the ordinary
            </p>
            <p class="m-0 text-[0.85rem] text-his-text-secondary italic">
              universal within the particular
            </p>
            <p class="m-0 text-[0.85rem] text-his-text-secondary italic">
              where word becomes flesh
            </p>
          </div>
          <div class="brand-meta mt-5 space-y-1.5 text-xs text-his-text-tertiary">
            <div>
              <Subscribe />
            </div>
            <p class="m-0">
              Hosts <a href="https://nadia.xyz/public-faith">Nadia</a> & <a href="https://henryzoo.com/living-out-in-faith">Henry</a>
            </p>
            <p class="m-0">
              Art Jessica Han <span aria-hidden="true">·</span> Music <a href="https://twitter.com/kenwheeler">Ken Wheeler</a>
            </p>
            <p class="m-0"><a href="https://github.com/sponsors/hzoo">Sponsor</a></p>
          </div>
        </div>
      </div>
    </header>

    <nav id="home-top-controls" aria-label="Site navigation">
      <div class="home-controls-inner">
        {!isHome && <a href="/" class="home-compact-link">Hope in Source</a>}
        <div class="home-view-list">
          <a
            href="/episodes"
            class="home-view-button"
            data-active={!isHome ? "true" : "false"}
            aria-current={!isHome ? "page" : undefined}
          >Episodes</a>
        </div>
      </div>
    </nav>

    <main id="home-layout-stage">
      {!isHome && <h1 class="sr-only">Episodes</h1>}
      <slot />
    </main>

    {!isHome && <div id="home-footer"><Footer compact /></div>}
  </div>
</Layout>
