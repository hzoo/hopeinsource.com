---
import HomeContentLayout from "@/layouts/HomeContentLayout.astro";
import ArchiveEpisodeRow from "@/components/ArchiveEpisodeRow.astro";
import { getEpisodeData } from "@/lib/episodes";

const { archiveGroups } = await getEpisodeData();
---

<HomeContentLayout page="episodes" title="All Episodes" description="Browse every Hope in Source episode by season.">
  <section id="home-archive" aria-label="Episodes by season">
    {archiveGroups.map((group, index) => {
      const previewCount = index === 0 ? 2 : 1;
      const preview = group.episodes.slice(0, previewCount);
      const rest = group.episodes.slice(previewCount);

      return (
        <section class="archive-season" id={`home-season-${group.id}`} aria-labelledby={`season-title-${group.id}`}>
          <div class="archive-season-heading">
            <h2 id={`season-title-${group.id}`}>{group.label}</h2>
            <span>{group.episodes.length} {group.episodes.length === 1 ? "episode" : "episodes"}</span>
          </div>

          <div class="archive-episode-list">
            {preview.map((episode) => <ArchiveEpisodeRow episode={episode} showDescription />)}
          </div>

          {rest.length > 0 && (
            <details class="archive-more">
              <summary>
                <span class="when-closed">Show {rest.length} more</span>
                <span class="when-open">Show fewer</span>
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="archive-episode-list">
                {rest.map((episode) => <ArchiveEpisodeRow episode={episode} />)}
              </div>
            </details>
          )}
        </section>
      );
    })}
  </section>
</HomeContentLayout>

<style>
  .archive-season + .archive-season { margin-top: 2.25rem; }
  .archive-season-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }
  .archive-season-heading h2 {
    margin: 0;
    color: var(--color-his-text);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.4;
  }
  .archive-season-heading > span {
    flex: none;
    color: var(--color-his-text-tertiary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .archive-episode-list { display: grid; }
  .archive-more { margin-top: 0.2rem; }
  .archive-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 40px;
    padding: 0 0.45rem;
    color: var(--color-his-text-secondary);
    font-size: 0.8125rem;
    cursor: pointer;
    list-style: none;
  }
  .archive-more summary::-webkit-details-marker { display: none; }
  .archive-more summary:hover { color: var(--color-his-green); }
  .archive-more summary:focus-visible { outline: 2px solid var(--color-his-green); outline-offset: 2px; }
  .archive-more .when-open,
  .archive-more[open] .when-closed { display: none; }
  .archive-more[open] .when-open { display: inline; }
  .archive-more svg { width: 14px; height: 14px; transition: transform 160ms ease; }
  .archive-more[open] svg { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    .archive-more svg { transition: none; }
  }
</style>
