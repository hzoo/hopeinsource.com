---
import HomeContentLayout from "@/layouts/HomeContentLayout.astro";
import { getEpisodeData } from "@/lib/episodes";
import { HOME_MOMENTS, formatMomentTime } from "@/lib/home-moments";

const episodeData = await getEpisodeData();
const episodeTitles = new Map(episodeData.episodes.map((episode) => [episode.slug, episode.episodeTitle]));
const latestSlug = episodeData.episodes.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]?.slug;
const conversations = HOME_MOMENTS.filter((moment) => moment.context);
const latestConversation = conversations.find((moment) => moment.slug === latestSlug);
const orderedConversations = latestConversation
  ? [latestConversation, ...conversations.filter((moment) => moment !== latestConversation)]
  : conversations;
const moments = orderedConversations.map((moment) => ({
  ...moment,
  episodeTitle: episodeTitles.get(moment.slug) ?? moment.slug,
  time: formatMomentTime(moment.seconds),
}));
const initialSlots = ["focus", "upper-left", "lower-right"];
---

<HomeContentLayout page="home">
  <section id="home-moments" aria-label="Moments from Hope in Source conversations">
    {moments.map((moment, index) => (
      <div
        class="home-moment"
        data-moment
        data-title={moment.episodeTitle}
        data-slot={initialSlots[index]}
        hidden={index >= initialSlots.length}
      >
        <button
          class:list={["home-moment-preview", "message", moment.side === "sent" ? "message-sent" : "message-received"]}
          type="button"
          data-preview
          aria-label={`Show conversation from ${moment.episodeTitle}`}
        >
          <span class="message-speaker"><strong>{moment.speaker}</strong></span>
          <span class="message-bubble">{moment.preview ?? moment.text}<span class="message-time">{moment.time}</span></span>
        </button>
        {moment.context && (
          <a
            class:list={["home-moment-context", "message", moment.context.before.side === "sent" ? "message-sent" : "message-received"]}
            href={`/${moment.slug}#msg-${moment.context.before.seconds}`}
          >
            <span class="message-speaker"><strong>{moment.context.before.speaker}</strong></span>
            <span class="message-bubble">{moment.context.before.text}<span class="message-time">{formatMomentTime(moment.context.before.seconds)}</span></span>
          </a>
        )}
        <a
          class:list={["home-moment-link", "message", moment.side === "sent" ? "message-sent" : "message-received", moment.context?.before.speaker === moment.speaker && "hide-speaker"]}
          href={`/${moment.slug}#msg-${moment.seconds}`}
          aria-label={`${moment.speaker} in ${moment.episodeTitle}: ${moment.text} At ${moment.time}.`}
        >
          <span class="message-speaker"><strong>{moment.speaker}</strong></span>
          <span class="message-bubble"><span class="home-moment-text">{moment.text}</span><span class="message-time">{moment.time}</span></span>
        </a>
        {moment.context && (
          <a
            class:list={["home-moment-context", "message", moment.context.after.side === "sent" ? "message-sent" : "message-received", moment.context.after.speaker === moment.speaker && "hide-speaker"]}
            href={`/${moment.slug}#msg-${moment.context.after.seconds}`}
          >
            <span class="message-speaker"><strong>{moment.context.after.speaker}</strong></span>
            <span class="message-bubble">{moment.context.after.text}<span class="message-time">{formatMomentTime(moment.context.after.seconds)}</span></span>
          </a>
        )}
        <div class="home-moment-actions">
          <button class="home-moment-next" type="button" data-next>Next conversation <span aria-hidden="true">→</span></button>
          <a class="home-moment-source" href={`/${moment.slug}#msg-${moment.seconds}`}>{moment.episodeTitle} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    ))}
    <span class="sr-only" aria-live="polite" data-status></span>
  </section>

  <script is:inline>
    (() => {
      const stage = document.getElementById("home-moments");
      if (!stage) return;
      const cards = Array.from(stage.querySelectorAll("[data-moment]"));
      if (cards.length < 2) return;

      const slots = ["focus", "upper-left", "lower-right"];
      let active = 0;

      const show = (index) => {
        active = (index + cards.length) % cards.length;
        cards.forEach((card, cardIndex) => {
          const distance = (cardIndex - active + cards.length) % cards.length;
          card.hidden = distance >= slots.length;
          if (card.hidden) delete card.dataset.slot;
          else card.dataset.slot = slots[distance];
        });
        stage.querySelector("[data-status]").textContent = `Showing ${cards[active].dataset.title}`;
        cards[active].querySelector("[data-next]").focus({ preventScroll: true });
      };

      stage.addEventListener("click", (event) => {
        const button = event.target.closest("[data-preview], [data-next]");
        if (!button) return;
        const index = cards.indexOf(button.closest("[data-moment]"));
        show(button.hasAttribute("data-next") ? index + 1 : index);
      });
    })();
  </script>
</HomeContentLayout>

<style>
  #home-moments {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 52rem;
    min-height: 40rem;
    margin: 0 auto;
    padding-block: 3rem;
    overflow: hidden;
  }

  .home-moment {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: max-content;
    max-width: min(80%, 36rem);
    margin: 0;
    color: var(--color-his-text);
  }

  .home-moment[hidden] { display: none; }
  .home-moment :is(.home-moment-link, .home-moment-context) { color: var(--color-his-text); text-decoration: none; }
  .home-moment :is(.home-moment-link, .home-moment-context):hover { color: var(--color-his-text); }
  .home-moment .message { max-width: 100%; }
  .home-moment .message-bubble { font-size: 1rem; }

  .home-moment-preview { display: none; }
  .home-moment:not([data-slot="focus"]) .home-moment-preview {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    width: 100%;
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .home-moment:not([data-slot="focus"]) :is(.home-moment-link, .home-moment-context, .home-moment-actions) { display: none; }
  .home-moment-context { display: none; }
  .home-moment[data-slot="focus"] .home-moment-context {
    display: flex;
    max-width: 94%;
  }
  .home-moment[data-slot="focus"] .home-moment-context .message-bubble {
    font-size: 0.94rem;
  }
  .home-moment[data-slot="focus"] .home-moment-link {
    position: relative;
    z-index: 1;
    margin-block: 0.45rem;
  }

  .home-moment-actions { display: none; }
  .home-moment[data-slot="focus"] .home-moment-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.3rem;
  }
  .home-moment-source {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-his-green);
    font-size: 0.75rem;
    line-height: 1.4;
    text-decoration: none;
  }
  .home-moment-source:hover { text-decoration: underline; text-underline-offset: 2px; }
  .home-moment-next {
    flex: none;
    min-height: 40px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--color-his-text-secondary);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.4;
    cursor: pointer;
  }
  .home-moment-next:hover { color: var(--color-his-green); }

  .home-moment[data-slot="focus"] {
    position: relative;
    z-index: 2;
    width: min(36rem, 90%);
    opacity: 1;
  }
  .home-moment:not([data-slot="focus"]) {
    color: var(--color-his-text-tertiary);
  }
  .home-moment:not([data-slot="focus"]) .message-speaker,
  .home-moment:not([data-slot="focus"]) .message-time {
    color: var(--color-his-text-tertiary);
  }
  .home-moment:not([data-slot="focus"]) .message-bubble {
    color: var(--color-his-text-tertiary);
    background: color-mix(in oklab, var(--color-his-chat-bg) 24%, var(--color-his-bg));
    font-size: 0.875rem;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .home-moment-preview:hover .message-bubble {
    color: var(--color-his-text-secondary);
    background: color-mix(in oklab, var(--color-his-chat-bg) 45%, var(--color-his-bg));
  }

  .home-moment[data-slot="upper-left"] {
    top: 1%; left: 5%; max-width: 17rem;
  }
  .home-moment[data-slot="lower-right"] {
    bottom: 1%; right: 1%; max-width: 17rem;
  }

  .home-moment :is(.home-moment-link, .home-moment-context, .home-moment-preview):focus-visible { outline: none; }
  .home-moment :is(.home-moment-link, .home-moment-context, .home-moment-preview):focus-visible .message-bubble {
    box-shadow: inset 0 0 0 2px var(--color-his-green);
  }
  .home-moment :is(.home-moment-source, .home-moment-next):focus-visible {
    outline: 2px solid var(--color-his-green);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    #home-moments { min-height: 0; padding-block: 0.75rem 1.5rem; }
    .home-moment .message-bubble { font-size: 0.94rem; }
    .home-moment[data-slot="focus"] { width: 96%; }
    .home-moment[data-slot="focus"] .home-moment-actions { flex-direction: column-reverse; align-items: flex-end; gap: 0; }
    .home-moment:not([data-slot="focus"]) { display: none; }
  }
</style>
