---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import EpisodeSidebar from "@/components/EpisodeSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AudioPlayer from "@/components/AudioPlayer.astro";
import Footer from "@/components/Footer.astro";
import { hisMetadata } from "@/metadata.ts";
import type { ExtractedLink } from "@/plugins/remark-links-extractor";
import { formatEpisodeDate, formatEpisodeDateValue } from "@/lib/dates";
import { getEpisodeData } from "@/lib/episodes";
import { getEpisodeAudioSource } from "@/lib/audio";

export async function getStaticPaths() {
  const { episodes } = await getEpisodeData();

  // Pre-render content at build time
  const pages = await Promise.all(
    episodes.map(async (episode) => {
      const { Content, headings, remarkPluginFrontmatter } = await render(episode);
      const h4Headings = headings.filter((h) => h.depth === 4);
      const extractedLinks = (remarkPluginFrontmatter?.extractedLinks || []) as ExtractedLink[];

      // Find other episodes by the same guest(s)
      const relatedByGuest = episode.guests
        .map(guest => ({
          guest,
          episodes: episodes
            .filter(ep => ep.slug !== episode.slug && ep.guests.includes(guest))
            .map(ep => ({ slug: ep.slug, title: ep.episodeTitle }))
        }))
        .filter(g => g.episodes.length > 0);

      return {
        params: { slug: episode.slug },
        props: {
          slug: episode.slug,
          Content,
          headings: h4Headings,
          frontmatter: episode.data,
          episodeNumber: episode.epNumber,
          extractedLinks,
          episodeTitle: episode.episodeTitle,
          guests: episode.guests,
          relatedByGuest,
          hasBody: Boolean(episode.body?.trim()),
        },
      };
    }),
  );

  return pages;
}

const { slug, Content, headings, frontmatter, episodeNumber, extractedLinks, episodeTitle, guests, relatedByGuest, hasBody } = Astro.props;

const videoUrl = frontmatter.video?.url ?? null;
const videoOffsetSeconds = frontmatter.video?.offsetSeconds ?? 0;

function getYouTubeVideoId(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === "youtu.be") {
      return parsed.pathname.slice(1) || null;
    }
    if (parsed.hostname.includes("youtube.com")) {
      return parsed.searchParams.get("v");
    }
  } catch {
    return null;
  }
  return null;
}

const videoId = videoUrl ? getYouTubeVideoId(videoUrl) : null;
const videoEmbedSrc = videoId
  ? `https://www.youtube-nocookie.com/embed/${videoId}?enablejsapi=1&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&cc_load_policy=0`
  : null;
const hasVideoPlayback = Boolean(videoEmbedSrc && videoUrl);
const audioSource = getEpisodeAudioSource(frontmatter.episodeLink);
const hasLongDescription = hasBody && frontmatter.description.length > 135;
---

<Layout frontmatter={frontmatter} slug={`/${slug}`}>
  <EpisodeSidebar currentSlug={slug} />

  <div
    id="episode-shell"
    class="lg:ml-80 flex flex-col h-screen"
    data-video-mode={hasVideoPlayback ? "read" : undefined}
  >
    {/* Sticky chat header - like DM conversation header */}
    <header
      id="chat-header"
      class="sticky top-0 z-20 bg-his-bg/95 backdrop-blur-sm border-b border-his-hr px-4 py-3 flex flex-col gap-3 transition-shadow duration-200"
      data-video-mode={hasVideoPlayback ? "read" : undefined}
    >
      <div class="episode-header-row w-full flex items-center gap-3 max-[360px]:flex-wrap">
        {/* Sidebar toggle (mobile/tablet) */}
        <button
          id="header-sidebar-toggle"
          class="lg:hidden w-10 h-10 rounded-full bg-his-hover/80 hover:bg-his-green/15 border border-his-hr hover:border-his-green/30 flex items-center justify-center flex-shrink-0 transition-colors"
          aria-label="Browse episodes"
          aria-controls="episode-sidebar"
          aria-expanded="false"
        >
          <svg class="w-4 h-4 text-his-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <div class="flex-1 min-w-0">
          <h1 class="truncate text-lg font-semibold leading-tight tracking-tight">{episodeTitle}</h1>
          <div class="episode-header-meta flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-his-text-tertiary leading-tight mt-0.5">
            {guests.length > 0 && (
              <span class="truncate text-his-text-secondary">{guests.join(", ")}</span>
            )}
            {guests.length > 0 && <span class="text-his-text-tertiary/40">·</span>}
            <span class="ep-badge">{episodeNumber}</span>
            <span class="text-his-text-tertiary/40 max-sm:hidden">·</span>
            <time class="max-sm:hidden" datetime={formatEpisodeDateValue(frontmatter.date)}>
              {formatEpisodeDate(frontmatter.date)}
            </time>
            {frontmatter.time && (
              <>
                <span class="text-his-text-tertiary/40 max-sm:hidden">·</span>
                <span class="max-sm:hidden">{frontmatter.time}m</span>
              </>
            )}
          </div>
        </div>
        {/* Episode-specific controls align with the shared search/theme controls. */}
        <nav class="episode-header-controls flex items-start gap-2 flex-shrink-0 max-[360px]:contents" aria-label="Episode controls">
        {hasVideoPlayback && (
          <>
            <div
              id="video-mode-toggle"
              class="mr-1 inline-flex items-center rounded-lg border border-his-hr bg-his-hover/40 p-0.5 max-[360px]:order-4 max-[360px]:basis-full max-[360px]:mr-0"
              role="group"
              aria-label="Episode view"
            >
              <button
                id="video-mode-read"
                type="button"
                class="video-mode-button flex h-10 w-10 items-center justify-center gap-1.5 rounded-md text-xs font-medium transition-[color,background-color,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60 max-[360px]:flex-1"
                aria-pressed="true"
                aria-controls="episode-video-shell"
                aria-label="Read transcript"
                title="Read transcript"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="3" width="16" height="18" rx="2" />
                  <path d="M8 8h8M8 12h8M8 16h5" />
                </svg>
                <span class="hidden max-[360px]:inline">Read</span>
              </button>
              <button
                id="video-mode-watch"
                type="button"
                class="video-mode-button flex h-10 w-10 items-center justify-center gap-1.5 rounded-md text-xs font-medium transition-[color,background-color,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60 max-[360px]:flex-1"
                aria-pressed="false"
                aria-controls="episode-video-shell"
                aria-label="Watch video"
                title="Watch video"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m10 9 5 3-5 3V9Z" />
                </svg>
                <span class="hidden max-[360px]:inline">Watch</span>
              </button>
            </div>
          </>
        )}
        <a href={hisMetadata.apple} target="_blank" rel="noreferrer" class="hidden sm:flex h-10 w-10 items-center justify-center rounded-lg text-his-text-tertiary hover:text-his-green hover:bg-his-hover transition-colors" title="Apple Podcasts">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5.34 0A5.328 5.328 0 000 5.34v13.32A5.328 5.328 0 005.34 24h13.32A5.328 5.328 0 0024 18.66V5.34A5.328 5.328 0 0018.66 0zm6.525 2.568c2.336 0 4.448.902 6.056 2.587 1.224 1.272 1.912 2.619 2.264 4.392.12.59.12 2.2.007 2.864a8.506 8.506 0 01-3.24 5.296c-.608.46-2.096 1.261-2.336 1.261-.088 0-.096-.091-.056-.46.072-.592.144-.715.48-.856.536-.224 1.448-.874 2.008-1.435a7.644 7.644 0 002.008-3.536c.208-.824.184-2.656-.048-3.504-.728-2.696-2.928-4.792-5.624-5.352-.784-.16-2.208-.16-3 0-2.728.56-4.984 2.76-5.672 5.528-.184.752-.184 2.584 0 3.336.456 1.832 1.64 3.512 3.192 4.512.304.2.672.408.824.472.336.144.408.264.472.856.04.36.03.464-.056.464-.056 0-.464-.176-.896-.384l-.04-.03c-2.472-1.216-4.056-3.274-4.632-6.012-.144-.706-.168-2.392-.03-3.04.36-1.74 1.048-3.1 2.192-4.304 1.648-1.737 3.768-2.656 6.128-2.656zm.134 2.81c.409.004.803.04 1.106.106 2.784.62 4.76 3.408 4.376 6.174-.152 1.114-.536 2.03-1.216 2.88-.336.43-1.152 1.15-1.296 1.15-.023 0-.048-.272-.048-.603v-.605l.416-.496c1.568-1.878 1.456-4.502-.256-6.224-.664-.67-1.432-1.064-2.424-1.246-.64-.118-.776-.118-1.448-.008-1.02.167-1.81.562-2.512 1.256-1.72 1.704-1.832 4.342-.264 6.222l.413.496v.608c0 .336-.027.608-.06.608-.03 0-.264-.16-.512-.36l-.034-.011c-.832-.664-1.568-1.842-1.872-2.997-.184-.698-.184-2.024.008-2.72.504-1.878 1.888-3.335 3.808-4.019.41-.145 1.133-.22 1.814-.211zm-.13 2.99c.31 0 .62.06.844.178.488.253.888.745 1.04 1.259.464 1.578-1.208 2.96-2.72 2.254h-.015c-.712-.331-1.096-.956-1.104-1.77 0-.733.408-1.371 1.112-1.745.224-.117.534-.176.844-.176zm-.011 4.728c.988-.004 1.706.349 1.97.97.198.464.124 1.932-.218 4.302-.232 1.656-.36 2.074-.68 2.356-.44.39-1.064.498-1.656.288h-.003c-.716-.257-.87-.605-1.164-2.644-.341-2.37-.416-3.838-.218-4.302.262-.616.974-.966 1.97-.97z"/>
          </svg>
        </a>
        <a href={hisMetadata.spotify} target="_blank" rel="noreferrer" class="hidden sm:flex h-10 w-10 items-center justify-center rounded-lg text-his-text-tertiary hover:text-his-green hover:bg-his-hover transition-colors" title="Spotify">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
        </a>
        <a href={hisMetadata.rss} target="_blank" rel="noopener noreferrer" class="hidden sm:flex h-10 w-10 items-center justify-center rounded-lg text-his-text-tertiary hover:text-his-green hover:bg-his-hover transition-colors" title="RSS Feed">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"/>
          </svg>
        </a>
        </nav>
      </div>

      {videoId && videoUrl && (
        <section id="episode-video-shell" class="mx-auto w-full max-w-3xl" aria-hidden="true" inert>
          <div
            id="episode-video-sync"
            data-video-src={videoEmbedSrc}
            data-video-url={videoUrl}
            data-video-offset-seconds={videoOffsetSeconds}
          >
            <div class="relative w-full aspect-video overflow-hidden rounded-xl border border-his-hr bg-black shadow-[0_8px_24px_rgba(0,0,0,0.18)]">
              <iframe
                id="episode-youtube-player"
                class="absolute inset-0 h-full w-full"
                title={`${episodeTitle} - YouTube`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
            <a
              href={videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 block text-right text-sm text-his-text-secondary hover:text-his-green focus-visible:outline-none focus-visible:underline"
            >
              Watch on YouTube ↗
            </a>
          </div>
        </section>
      )}
    </header>

    <div id="episode-scroll-container" class="flex-1 overflow-y-auto">
    <main
      id="episode-content-shell"
      class="mx-auto px-3 sm:px-4 pt-4 pb-4 sm:pt-6 flex flex-col lg:max-w-4xl"
      data-video-layout={hasVideoPlayback ? "true" : "false"}
      data-video-mode={hasVideoPlayback ? "read" : undefined}
    >
    {hasLongDescription && (
      <details class="episode-description-disclosure mx-auto mb-4 w-full max-w-[600px] sm:hidden">
        <summary>
          <span class="episode-description-copy block text-[15px] leading-relaxed text-his-text-secondary">
            {frontmatter.description}
          </span>
          <span class="episode-description-more mt-0.5 block text-xs text-his-green">More</span>
          <span class="episode-description-less mt-0.5 hidden text-xs text-his-green">Less</span>
        </summary>
      </details>
    )}
    <p class:list={["mx-auto mb-4 w-full max-w-[600px] text-[15px] leading-relaxed text-his-text-secondary", hasLongDescription && "hidden sm:block"]}>
      {frontmatter.description}
    </p>

    <TableOfContents headings={headings} extractedLinks={extractedLinks} />

    <div class="mx-auto w-full min-w-0 max-w-[600px]">
      {hasBody
        ? <Content />
        : <p class="py-8 text-center text-sm text-his-text-secondary">Transcript coming soon. You can listen to the episode.</p>}
    </div>
    {relatedByGuest.length > 0 && (
      <aside aria-label="Related episodes" class="mx-auto mt-12 max-w-3xl text-center text-xs text-his-text-tertiary space-y-1">
        {relatedByGuest.map(({ guest, episodes: related }) => (
          <p>
            More with {guest.split(" ")[0]}{" · "}
            {related.map((ep, i) => (
              <>
                {i > 0 && " · "}
                <a href={`/${ep.slug}`} class="text-his-text-secondary hover:text-his-green transition-colors">
                  {ep.title}
                </a>
              </>
            ))}
          </p>
        ))}
      </aside>
    )}
    </main>
    <Footer compact={!hasBody} />
    </div>
    <div class="audio-player-dock shrink-0 border-t border-his-hr bg-his-bg">
      <AudioPlayer title={episodeTitle} src={audioSource} />
    </div>
  </div>

  {hasVideoPlayback && <script src="../scripts/video-player.ts"></script>}
  <script src="../scripts/episode.ts"></script>
</Layout>

<style>
  .episode-description-disclosure summary {
    list-style: none;
    cursor: pointer;
  }

  .episode-description-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .episode-description-disclosure:not([open]) .episode-description-copy {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .episode-description-disclosure[open] .episode-description-more,
  .episode-description-disclosure:not([open]) .episode-description-less {
    display: none;
  }

  .episode-description-disclosure[open] .episode-description-less {
    display: block;
  }

  .episode-description-disclosure summary:focus-visible {
    outline: 2px solid var(--color-his-green);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
