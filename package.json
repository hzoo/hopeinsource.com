{
  "name": "hopeinsource",
  "workspaces": [
    "src/remark-transcript-plugin"
  ],
  "type": "module",
  "private": true,
  "description": "Hope in Source website",
  "version": "1.0.0",
  "author": "Henry Zhu <hi@henryzoo.com>",
  "bugs": {
    "url": "https://github.com/hzoo/hopeinsource.com/issues"
  },
  "homepage": "https://hopeinsource.com",
  "license": "MIT",
  "scripts": {
    "dev": "bun run build:images && astro dev",
    "start": "bun run dev",
    "build": "bun run build:images && astro check && astro build --force && bun run scripts/build-search-index.ts",
    "build:force": "bun run build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "bun run build:force && wrangler pages deploy dist --project-name hopeinsource-com",
    "build:images": "bun run scripts/build-cover-images.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.4",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
