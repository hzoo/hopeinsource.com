{
  "name": "hopeinsource",
  "type": "module",
  "private": true,
  "description": "Hope in Source website",
  "version": "1.0.0",
  "author": "Henry Zhu <hi@henryzoo.com>",
  "bugs": {
    "url": "https://github.com/hzoo/hopeinsource.com/issues"
  },
  "homepage": "https://hopeinsource.com",
  "license": "MIT",
  "scripts": {
    "dev": "bun run build:images && astro dev",
    "start": "bun run dev",
    "check": "astro check",
    "check:site": "bun run scripts/check-site.ts",
    "test": "bun test",
    "test:transcripts": "python3 -m unittest discover -s scripts/transcript-pipeline",
    "build": "bun run build:images && bun run check && astro build --force && bun run build:search",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "bun run build && bun run check:site && CLOUDFLARE_ACCOUNT_ID=899db3f6d2659dfb20376c7e752c862d bunx wrangler@4.140.0 pages deploy dist --project-name hopeinsource-com --branch=main",
    "deploy:preview": "bun run build && bun run check:site && CLOUDFLARE_ACCOUNT_ID=899db3f6d2659dfb20376c7e752c862d bunx wrangler@4.140.0 pages deploy dist --project-name hopeinsource-com --branch=preview",
    "build:images": "bun run scripts/build-cover-images.ts",
    "build:search": "bun run scripts/build-search-index.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.4",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "entities": "^6.0.1",
    "rehype-stringify": "^10.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  }
}
