/_astro/*
  Cache-Control: public, max-age=31556952, immutable

# Unversioned search bundle for cached clients.
/pagefind/pagefind.js
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/pagefind/pagefind-worker.js
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/pagefind/wasm.*.pagefind
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/pagefind/pagefind-entry.json
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/pagefind/index/*
  Cache-Control: public, max-age=31556952, immutable

/pagefind/filter/*
  Cache-Control: public, max-age=31556952, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31556952, immutable

# Runtime URLs change with the pinned Pagefind release. The corpus can change
# within that release, so the entry manifest still revalidates.
/pagefind/:version/pagefind.js
  Cache-Control: public, max-age=31556952, immutable

/pagefind/:version/pagefind-worker.js
  Cache-Control: public, max-age=31556952, immutable

/pagefind/:version/wasm.*.pagefind
  Cache-Control: public, max-age=31556952, immutable

/pagefind/:version/pagefind-entry.json
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/pagefind/:version/index/*
  Cache-Control: public, max-age=31556952, immutable

/pagefind/:version/filter/*
  Cache-Control: public, max-age=31556952, immutable

/pagefind/:version/fragment/*
  Cache-Control: public, max-age=31556952, immutable

# The splat also matches metadata under versioned directories.
/pagefind/*.pf_meta
  Cache-Control: public, max-age=31556952, immutable

/pagefind/vocabulary.json
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/pagefind/vocabulary-*.json
  Cache-Control: public, max-age=31556952, immutable
